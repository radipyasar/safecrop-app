# Copy this file to backend/.env and fill in the values. Never commit .env.
# Gemini key from https://aistudio.google.com (free, no card)
GEMINI_API_KEY=
# Hugging Face token with read rights to the private model repo
HF_TOKEN=
# Front-end addresses allowed to call the API, comma-separated, no slash at the end
ALLOWED_ORIGINS=http://localhost:5173
# Optional: where the SQLite check log is written (default backend/safecrop.db; numbers and labels only, no photos)
# DB_PATH=
